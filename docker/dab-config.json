{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v1.2.11/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "Server=sqlserver,1433;Database=ResearchAssistant;User Id=sa;Password=Research@Assistant123;TrustServerCertificate=true"
  },
  "runtime": {
    "rest": { "enabled": true },
    "graphql": { "enabled": true },
    "host": {
      "mode": "development",
      "cors": { "origins": ["*"] }
    }
  },
  "entities": {
    "Movie": {
      "source": "dbo.Movies",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Director": {
      "source": "dbo.Directors",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Actor": {
      "source": "dbo.Actors",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Genre": {
      "source": "dbo.Genres",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Review": {
      "source": "dbo.Reviews",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    }
  }
}
