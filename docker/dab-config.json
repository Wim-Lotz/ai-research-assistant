{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v1.2.11/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "Server=sqlserver,1433;Database=NexusSupport;User Id=sa;Password=Research@Assistant123;TrustServerCertificate=true"
  },
  "runtime": {
    "rest": { "enabled": true },
    "graphql": { "enabled": true },
    "host": {
      "mode": "development",
      "cors": { "origins": ["*"] }
    },
    "mcp": { "enabled": true }
  },
  "entities": {
    "Department": {
      "source": "dbo.Departments",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Employee": {
      "source": "dbo.Employees",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Customer": {
      "source": "dbo.Customers",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    },
    "Ticket": {
      "source": "dbo.Tickets",
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    }
  }
}
