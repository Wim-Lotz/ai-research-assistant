@host = http://localhost:5190

GET {{host}}/health
Accept: application/json

###

POST {{host}}/generate
Content-Type: application/json

{
  "prompt": "What is a vector database?"
}

###

GET http://localhost:6333/collections
Accept: application/json

###

POST http://localhost:5190/ingest
Content-Type: application/json

{
  "text": "A vector database stores and searches high dimensional vectors efficiently using similarity search algorithms like cosine similarity."
}

###

POST http://localhost:5190/ingest
Content-Type: application/json

{
  "text": "Machine learning is a subset of artificial intelligence that enables systems to learn and improve from experience without being explicitly programmed."
}

###

POST http://localhost:5190/ingest
Content-Type: application/json

{
  "text": "Docker containers package software and its dependencies together, ensuring consistent behaviour across different computing environments."
}

